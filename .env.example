# ---- Local development (copy to .env.local) ---------------------------------

# Where lib/api.ts sends /api/* calls.
#   Local:      the FastAPI backend run on your machine (default when unset).
#   Production: "/backend" — the browser can NOT call Cloud Run directly (the
#               org policy forbids allUsers), so requests go to the same-origin
#               relay in app/backend/[...path]/route.ts, which signs them with
#               the service account. Never put the run.app URL here.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google OAuth Web Client ID — the SAME value as the backend's GOOGLE_CLIENT_ID
# (the backend checks the token audience). The deployment's origin must be an
# Authorized JavaScript origin on that client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# OpenRouter API key (server-side only) — powers the header's credits/spend
# strip via app/api/or-stats/route.ts. Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# UI-lab preview mode: "1" boots the shell as a mock all-roles user and answers
# known GETs from lib/demo.ts fixtures. Leave unset (or "0") everywhere that
# real people sign in — a live deployment must never run on fixtures.
# NEXT_PUBLIC_PREVIEW_NO_AUTH=0

# ---- Production only (Vercel project settings, never committed) ---------------

# Cloud Run service the relay forwards to. Set it explicitly per environment
# (production: agentsbackend; staging: agentsbackend-staging) — do not rely on
# the fallback baked into the relay.
# BACKEND_ORIGIN=https://agentsbackend-xxxxx.us-central1.run.app

# Service-account key JSON (one line) the relay uses to mint a Cloud Run
# identity token. Without it every backend call answers 503.
# GCP_SA_KEY=
